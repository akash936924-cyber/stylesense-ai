# Closet Labs — copy to .env.local and fill in what you have.
# Everything is optional: with no keys the app runs on labeled demo data.

# ── Product search (free tiers) ────────────────────────────────────────────
# Channel3 — primary fashion catalog + affiliate links. https://trychannel3.com
CHANNEL3_API_KEY=

# eBay Browse API — marketplace/resale tier. https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Tavily — searches non-Shopify custom stores (1,000 free credits/mo). https://tavily.com
TAVILY_API_KEY=

# ── Later phases ───────────────────────────────────────────────────────────
# Supabase (auth + pgvector cache) — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rakuten Advertising (Nordstrom-tier retailers; apply early, approval takes weeks)
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=

# Etsy Open API v3 (optional marketplace source)
ETSY_API_KEY=

# Pinterest API (only needed for OAuth board sync — pasting pin links needs no key)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
